    "test:report-choices": "vitest run src/lib/__tests__/meta-launch-scope.test.ts src/lib/__tests__/report-type-preferences.test.ts src/lib/nre/__tests__/wizard-report-type-copy.test.ts src/lib/nre/__tests__/wizard-draft.test.ts src/lib/nre/__tests__/wizard-generate-snapshot.test.ts src/lib/nre/__tests__/report-period-selection.test.ts src/lib/nre/__tests__/selected-report-output.test.ts src/lib/nre/__tests__/historical-report-data.test.ts src/lib/nre/__tests__/day-breakdown-report-data.test.ts src/lib/nre/__tests__/wizard-report-csv-requirement.test.ts src/lib/nre/__tests__/wizard-report-export-guidance.test.ts",
