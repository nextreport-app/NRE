    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
