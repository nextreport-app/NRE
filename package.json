    "meta:tier-qualification": "node scripts/meta-tier-qualification.js",
    "blob:purge-ephemeral": "tsx scripts/purge-vercel-blob-ephemeral.ts",
    "postinstall": "prisma generate",
    "test:lifecycle": "vitest run src/lib/__tests__/lifecycle-delivery.postgres.test.ts src/lib/__tests__/lifecycle-email-copy.test.ts src/lib/__tests__/admin-report-digest.test.ts",
