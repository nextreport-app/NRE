    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.9.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
