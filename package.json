{
  "name": "nextreport-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:objective-regression": "vitest run src/lib/nre/__tests__/meta-objective-regression.test.ts src/lib/nre/__tests__/google-objective-regression.test.ts src/lib/nre/__tests__/tiktok-objective-regression.test.ts src/lib/nre/__tests__/meta-dictionary-consistency.test.ts src/lib/nre/__tests__/gz-australia-cpl.test.ts src/lib/nre/__tests__/gz-australia-api-objective.test.ts src/lib/nre/__tests__/cpr-parity-golden.test.ts src/lib/nre/__tests__/credit-firm-dual-export-parity.test.ts src/lib/nre/__tests__/meta-csv-export-profile.test.ts src/lib/nre/__tests__/csv-report-reconciliation-mtd-multi-objective.test.ts src/lib/nre/__tests__/count-column-units.test.ts",
    "test:reporting-accuracy": "vitest run src/lib/nre/__tests__/meta-primary-evidence.test.ts src/lib/nre/__tests__/numeric-accounting.test.ts src/lib/nre/__tests__/accounting-contract.test.ts src/lib/nre/__tests__/count-column-units.test.ts src/lib/nre/__tests__/pptx-accounting-contract.test.ts src/lib/__tests__/plan-pricing.test.ts scripts/lib/__tests__/meta-row-diff.test.ts",
    "test:api-routes": "vitest run src/app/api/__tests__",
    "meta:tier-qualification": "node scripts/meta-tier-qualification.js",
    "blob:purge-ephemeral": "tsx scripts/purge-vercel-blob-ephemeral.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
