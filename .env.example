# Database (PostgreSQL — Supabase, PlanetScale-compatible, or self-hosted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextreport"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXTAUTH_URL="http://localhost:3000"

# File storage for generated reports — required in every environment,
# including local dev (no local-disk fallback: Vercel's serverless functions
# have no writable filesystem to hand a file from one request to the next).
# On Vercel: enable Blob storage on the project (Storage tab → Create Database
# → Blob) and connect it — this auto-injects BLOB_READ_WRITE_TOKEN, don't set
# it by hand there. Locally: run `vercel env pull .env` after connecting Blob
# storage to pull the same token down, or generate a token from the Vercel
# dashboard's Blob store settings.
BLOB_READ_WRITE_TOKEN=""

# AI insight writing (Groq primary, Gemini fallback) — platform-level, shared
# across every client, not configured per client in the app UI. Either or
# both may be left blank; the generated report falls back to a placeholder
# string wherever AI copy would have gone if neither is configured or both
# calls fail.
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Razorpay (subscription billing — see lib/razorpay.ts and
# api/payments/create-order + verify) — platform-level, like the AI keys
# above, not configured per client. The values below are TEST MODE
# credentials (rzp_test_ prefix) for local/staging use only — replace all
# three with LIVE keys from the Razorpay dashboard before accepting real
# payments in production, and set them on Vercel too (Project → Settings →
# Environment Variables — see README.md's Vercel env var table).
#
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend — it's only
# read server-side (lib/razorpay.ts, api/payments/verify) and Next.js does
# not inline a var into client bundles unless it's prefixed NEXT_PUBLIC_.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is intentionally the same value as
# RAZORPAY_KEY_ID — Razorpay's key ID is a publishable identifier, safe to
# ship to the browser (Razorpay Checkout needs it client-side to open the
# payment modal); the secret is what must stay server-only.
RAZORPAY_KEY_ID="rzp_test_TJ49mGBz88M6dz"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_TJ49mGBz88M6dz"
RAZORPAY_KEY_SECRET="H8SYI4xcoCUDU9L5YMEOGRAY"
