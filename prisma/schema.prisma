// NextReport Engine (NRE v1) — Prisma schema
// Auth models follow the Auth.js (NextAuth v5) Prisma adapter contract.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── AUTH (Auth.js v5) ────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // bcrypt hash — null for OAuth-only accounts
  passwordHash  String?

  // Agency branding (account settings) — appears on every report this user
  // generates for any of their clients: agencyName as the cover slide's
  // "Prepared by" line, agencyLogoUrl (Vercel Blob, private access, always
  // normalized to PNG server-side) as the small footer logo on every slide.
  // Both optional; either/both absent means those elements are simply
  // skipped at render time, never shown empty.
  agencyName    String?
  agencyLogoUrl String?

  accounts Account[]
  sessions Session[]
  clients  Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── DOMAIN MODELS ─────────────────────────────────

enum Currency {
  INR
  USD
  GBP
  AUD
  CAD
  AED
}

enum ReportTemplate {
  DARK
  LIGHT
  EMERALD
  PURPLE
  CRIMSON
  GRAPHITE
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

model Client {
  id            String         @id @default(cuid())
  userId        String
  accountName   String
  currency      Currency       @default(INR)
  timezone      String         @default("Asia/Kolkata")
  monthlyBudget Float?
  template      ReportTemplate @default(DARK)

  // Client logo (Vercel Blob, private access, always normalized to PNG
  // server-side) — shown bottom-right on every report's cover slide for
  // this client. Absent means the cover slide renders exactly as it does
  // without this feature — no placeholder box.
  logoUrl String?

  // Report upload wizard preferences — remembered per client so the next
  // upload pre-selects the same campaigns / date-range mode. Both are JSON
  // text (matching Report.summaryJson's existing convention) rather than a
  // native Json column, since Prisma's Json type isn't used anywhere else
  // in this schema.
  // lastDeselectedCampaigns: JSON { campaigns: string[], deselected: string[] }
  // — the full campaign list from the upload that saved this, plus the
  // EXCLUDED subset of it (not the selected ones). Keeping the full list
  // alongside the exclusion set (rather than just the exclusion set alone)
  // is what lets a later upload tell a genuinely new campaign apart from
  // one that was always there and simply never excluded — see
  // lib/nre/campaigns.ts's resolveCampaignSelection, which drives the
  // report upload wizard's Campaigns step.
  lastDeselectedCampaigns String? @db.Text
  // lastDeselectedAdSets: JSON string[] of EXCLUDED ad set composite keys
  // (see ad-sets.ts's adSetKey — "campaign adset", since ad set names
  // alone aren't unique across campaigns). Ad-set-level filtering was
  // removed from the wizard (see report-upload-wizard.tsx's file header) —
  // this column is no longer read or written, kept only so existing rows
  // aren't silently dropped.
  lastDeselectedAdSets String? @db.Text
  // lastDateSelection: JSON { mode: "last7" | "prev7" | "custom", customStart?: "YYYY-MM-DD", customEnd?: "YYYY-MM-DD" }.
  lastDateSelection       String? @db.Text

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Report {
  id       String       @id @default(cuid())
  clientId String
  status   ReportStatus @default(PENDING)

  weekStart String?
  weekEnd   String?
  fileName  String?
  filePath  String?
  // Cached Drive webViewLink once "Get Google Slides Link" has been used —
  // avoids creating a duplicate Drive file on every click.
  slidesUrl String?

  // Snapshot of computed metrics for history/preview without re-parsing the pptx
  summaryJson  String? @db.Text
  errorMessage String? @db.Text

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}
