// NextReport Engine (NRE v1) — Prisma schema
// Auth models follow the Auth.js (NextAuth v5) Prisma adapter contract.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── AUTH (Auth.js v5) ────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // bcrypt hash — null for OAuth-only accounts
  passwordHash  String?

  // Subscription / billing (Razorpay) — drives feature gating across the
  // app (see lib/subscription.ts's getSubscriptionStatus, the single source
  // of truth for what "trial"/"starter"/"professional"/"cancelled" allow).
  // "cancelled" is kept distinct from "trial" so a lapsed subscriber is
  // paywalled immediately rather than getting a fresh 7-day trial.
  //
  // trialEndsAt defaults to 7 days from row creation via a DB-level
  // computed default (not application code) so every user-creation path
  // gets a correct trial end date automatically — both the credentials
  // signup route (api/auth/signup) AND the NextAuth Prisma adapter's own
  // user creation on first Google sign-in (which never runs our signup
  // route at all), without duplicating "now + 7 days" in two places that
  // could drift out of sync.
  //
  // razorpayCustomerId/razorpaySubscriptionId are reserved for a future
  // move to Razorpay's Subscriptions API (real recurring auto-billing).
  // The current integration (api/payments/create-order + verify) only
  // uses Razorpay's one-time Orders API — see lib/razorpay.ts's file
  // header — so neither column is populated by that flow today.
  planId                 String    @default("trial")
  trialEndsAt            DateTime  @default(dbgenerated("(now() + interval '7 days')"))
  subscribedAt           DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?

  // Agency branding (account settings) — appears on every report this user
  // generates for any of their clients: agencyName as the cover slide's
  // "Prepared by" line, agencyLogoUrl (Vercel Blob, private access, always
  // normalized to PNG server-side) as the small footer logo on every slide.
  // Both optional; either/both absent means those elements are simply
  // skipped at render time, never shown empty.
  agencyName    String?
  agencyLogoUrl String?

  // Google Drive connection (account settings) — deliberately independent
  // of both the Credentials/Google sign-in above AND the NextAuth Account
  // row Google sign-in creates: a user can log into NextReport with email/
  // password (or a Google account) and still connect a COMPLETELY DIFFERENT
  // Google account here for Drive uploads (see the connect flow's own
  // explanatory copy in the account settings UI). That's why these are
  // their own columns rather than reusing Account.refresh_token/
  // access_token — this is a second, separate OAuth grant, obtained via
  // /api/google-drive/connect + /api/google-drive/callback (NOT NextAuth's
  // own Google provider), always re-requesting `prompt=consent
  // select_account` so the account chooser appears every time and a fresh
  // refresh_token comes back.
  //
  // googleDriveEnabled simply mirrors "is a Drive account currently
  // connected" — set true alongside the tokens/email on a successful
  // connect, false alongside clearing them on disconnect (see
  // /api/google-drive/callback and /disconnect). There's no separate
  // auto-save toggle or folder configuration on this model anymore: saving
  // a report to Drive is an explicit, per-report action from the download
  // screen's "Save to Google Drive" button (see report-upload-wizard.tsx),
  // gated on this flag / googleRefreshToken being present.
  googleDriveEnabled   Boolean @default(false)
  // googleAccessToken is best-effort/informational only — every Drive call
  // (lib/google-drive.ts's saveReportToDriveFolder) mints a fresh access
  // token from googleRefreshToken right before use rather than trusting
  // this column's freshness, so there's no separate "is it expired yet"
  // column to maintain.
  googleAccessToken    String? @db.Text
  googleRefreshToken   String? @db.Text
  // The connected Google account's own email — shown back to the user
  // ("Connected: name@example.com") specifically so they can confirm they
  // picked the Drive account they meant to, since it doesn't have to match
  // their NextReport login email at all.
  googleConnectedEmail String?

  accounts Account[]
  sessions Session[]
  clients  Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── DOMAIN MODELS ─────────────────────────────────

enum Currency {
  INR
  USD
  GBP
  AUD
  CAD
  AED
  NZD
  SGD
  MYR
  PHP
  ZAR
  BRL
  MXN
  EUR
}

enum ReportTemplate {
  DARK
  LIGHT
  EMERALD
  PURPLE
  CRIMSON
  GRAPHITE
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

model Client {
  id            String         @id @default(cuid())
  userId        String
  accountName   String
  currency      Currency       @default(INR)
  timezone      String         @default("Asia/Kolkata")
  monthlyBudget Float?
  template      ReportTemplate @default(DARK)

  // Client logo (Vercel Blob, private access, always normalized to PNG
  // server-side) — shown bottom-right on every report's cover slide for
  // this client. Absent means the cover slide renders exactly as it does
  // without this feature — no placeholder box.
  logoUrl String?

  // Last Google Drive folder this client's reports were saved to (download
  // screen's "Save to Google Drive" button, report-upload-wizard.tsx) —
  // purely a convenience default: the folder picker pre-selects this folder
  // next time, but the user can always navigate elsewhere or confirm it.
  // Both null means this client has never had a report saved to Drive yet,
  // so the picker opens at Drive's root with nothing pre-selected.
  lastDriveFolderId   String?
  lastDriveFolderName String?

  // Report upload wizard preferences — remembered per client so the next
  // upload pre-selects the same campaigns / date-range mode. Both are JSON
  // text (matching Report.summaryJson's existing convention) rather than a
  // native Json column, since Prisma's Json type isn't used anywhere else
  // in this schema.
  // lastDeselectedCampaigns: JSON { campaigns: string[], deselected: string[] }
  // — the full campaign list from the upload that saved this, plus the
  // EXCLUDED subset of it (not the selected ones). Keeping the full list
  // alongside the exclusion set (rather than just the exclusion set alone)
  // is what lets a later upload tell a genuinely new campaign apart from
  // one that was always there and simply never excluded — see
  // lib/nre/campaigns.ts's resolveCampaignSelection, which drives the
  // report upload wizard's Campaigns step.
  lastDeselectedCampaigns String? @db.Text
  // lastDeselectedAdSets: JSON string[] of EXCLUDED ad set composite keys
  // (see ad-sets.ts's adSetKey — "campaign adset", since ad set names
  // alone aren't unique across campaigns). Ad-set-level filtering was
  // removed from the wizard (see report-upload-wizard.tsx's file header) —
  // this column is no longer read or written, kept only so existing rows
  // aren't silently dropped.
  lastDeselectedAdSets    String? @db.Text
  // lastDateSelection: JSON { mode: "last7" | "prev7" | "custom", customStart?: "YYYY-MM-DD", customEnd?: "YYYY-MM-DD" }.
  lastDateSelection       String? @db.Text

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Report {
  id       String       @id @default(cuid())
  clientId String
  status   ReportStatus @default(PENDING)

  weekStart String?
  weekEnd   String?
  fileName  String?
  filePath  String?
  // Cached Drive webViewLink once "Get Google Slides Link" has been used —
  // avoids creating a duplicate Drive file on every click.
  slidesUrl String?

  // Snapshot of computed metrics for history/preview without re-parsing the pptx
  summaryJson  String? @db.Text
  errorMessage String? @db.Text

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}
